  "create_controlling.ponder.control_panel.header": "Building a Control Console",
  "create_controlling.ponder.control_panel.text_1": "A Control Console starts out as a blank, sloped face",
  "create_controlling.ponder.control_panel.text_2": "Sneak-click it with an empty hand to open the Console Designer",
  "create_controlling.ponder.control_panel.text_3": "Mount parts anywhere on the face; each one costs a few materials",
  "create_controlling.ponder.control_panel.text_4": "Buttons, switches, knobs and sliders send redstone signals",
  "create_controlling.ponder.control_panel.text_5": "Lamps, gauges and nixie tubes show the signals they receive",
  "create_controlling.ponder.control_panel.text_6": "Sneak-click with a Wrench to change the slope",
  "create_controlling.ponder.control_panel.text_7": "Right-click with a Create casing to re-dress the console",
  "create_controlling.ponder.control_panel_linking.header": "Linking Consoles to Redstone",
  "create_controlling.ponder.control_panel_linking.text_1": "Every part on a console has its own Redstone Link frequency",
  "create_controlling.ponder.control_panel_linking.text_2": "Give a switch the same frequency as a Redstone Link…",
  "create_controlling.ponder.control_panel_linking.text_3": "…and flipping it powers that link from anywhere in range",
  "create_controlling.ponder.control_panel_linking.text_4": "A button sends a short pulse instead",
  "create_controlling.ponder.control_panel_linking.text_5": "Knobs and sliders send any strength from 0 to 15",
  "create_controlling.ponder.control_panel_linking.text_6": "Click to step up, Sneak-click to step back down",
  "create_controlling.ponder.control_panel_linking.text_7": "Lamps and gauges listen on their frequency instead",
  "create_controlling.ponder.control_panel_linking.text_8": "Any transmitter on it lights them up, even another console",
  "create_controlling.ponder.control_panel_display.header": "Showing Display Link text on a Console",
  "create_controlling.ponder.control_panel_display.text_1": "Nixie Strips and Display Boards are readouts for text",
  "create_controlling.ponder.control_panel_display.text_2": "Point a Display Link at the console, just like at a Display Board",
  "create_controlling.ponder.control_panel_display.text_3": "The readouts follow whatever the link reads",
  "create_controlling.ponder.control_panel_display.text_4": "Each readout picks its line in the Console Designer; two can share one"
}
